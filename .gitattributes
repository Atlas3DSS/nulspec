* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Raw terminal logs and upstream-compatible patches may legitimately preserve
# progress-bar carriage returns or whitespace-only context lines.
*.log -whitespace
*.patch -whitespace

*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
