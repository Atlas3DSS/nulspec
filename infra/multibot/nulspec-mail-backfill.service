[Unit]
Description=Import historical NULSPEC nomination embeds into the mail queue
Wants=network-online.target
After=network-online.target multibot.service

[Service]
Type=oneshot
User=multibot
Group=multibot
WorkingDirectory=/srv/multibot/current
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/multibot/multibot.env
EnvironmentFile=-/etc/nulspec-mail.env
ExecStart=/srv/multibot/venv/bin/python /srv/multibot/current/nulspec_mail.py backfill-discord
UMask=0077

CPUQuota=25%
MemoryHigh=192M
MemoryMax=256M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/multibot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
