# Install as /etc/nulspec-mail.env, owned by root:root with mode 0600.
# Use separate PurelyMail application passwords for SMTP and IMAP.
NULSPEC_MAILBOX=research@nulspec.com
NULSPEC_MAIL_SMTP_HOST=smtp.purelymail.com
NULSPEC_MAIL_SMTP_PORT=465
NULSPEC_MAIL_SMTP_USERNAME=research@nulspec.com
NULSPEC_MAIL_SMTP_PASSWORD=replace-with-smtp-app-password
NULSPEC_MAIL_IMAP_HOST=imap.purelymail.com
NULSPEC_MAIL_IMAP_PORT=993
NULSPEC_MAIL_IMAP_USERNAME=research@nulspec.com
NULSPEC_MAIL_IMAP_PASSWORD=replace-with-imap-app-password
NULSPEC_MAIL_CHANNEL_ID=1532567350472343653
NULSPEC_MAIL_POLL_SECONDS=60
NULSPEC_MAIL_DB_PATH=/var/lib/multibot/nulspec-mail.sqlite3
NULSPEC_MAIL_RELEASE_MANIFEST=/srv/nulspec/current/release.json
