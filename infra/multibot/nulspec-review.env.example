# Install as /etc/nulspec-review.env, owned by root:root with mode 0600.
# Generate the two base64url values with nulspec_review.py; never commit them.
NULSPEC_REVIEW_ENABLED=1
NULSPEC_REVIEW_ACCOUNTS_B64=replace-with-encoded-account-envelope
NULSPEC_REVIEW_PEPPER_B64=replace-with-at-least-32-random-bytes
NULSPEC_REVIEW_DB_PATH=/var/lib/multibot/nulspec-review.sqlite3
NULSPEC_REVIEW_ALLOWED_ORIGINS=https://nulspec.com
NULSPEC_REVIEW_SESSION_HOURS=12
NULSPEC_REVIEW_COOKIE_SECURE=1
