{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_confirmation",
    "teacher_assessments",
    "teacher_disagreement_present",
    "teacher_disagreements",
    "citation_adjudications",
    "final_qwen_reviewer_quality_score",
    "overall_assessment",
    "boundary_limitations",
    "release_controls",
    "summary"
  ],
  "properties": {
    "scope_confirmation": {
      "type": "string",
      "enum": ["qwen_records_and_teacher_audits_only"]
    },
    "teacher_assessments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "teacher",
          "execution_chain_valid",
          "scientific_assessment",
          "qwen_quality_score",
          "strengths",
          "limitations"
        ],
        "properties": {
          "teacher": {"type": "string", "enum": ["glm", "kimi"]},
          "execution_chain_valid": {"type": "boolean"},
          "scientific_assessment": {"type": "string", "enum": ["pass", "warn", "fail"]},
          "qwen_quality_score": {"type": "integer", "minimum": 1, "maximum": 10},
          "strengths": {
            "type": "array",
            "maxItems": 32,
            "items": {"type": "string", "minLength": 1, "maxLength": 1200}
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {"type": "string", "minLength": 1, "maxLength": 1200}
          }
        }
      }
    },
    "teacher_disagreement_present": {"type": "boolean"},
    "teacher_disagreements": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "glm_position", "kimi_position", "adjudication"],
        "properties": {
          "topic": {"type": "string", "minLength": 1, "maxLength": 500},
          "glm_position": {"type": "string", "minLength": 1, "maxLength": 1600},
          "kimi_position": {"type": "string", "minLength": 1, "maxLength": 1600},
          "adjudication": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "citation_adjudications": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["citation_key", "occurrence_id", "status", "basis"],
        "properties": {
          "citation_key": {"type": "string", "minLength": 1, "maxLength": 160},
          "occurrence_id": {"type": "string", "maxLength": 220},
          "status": {
            "type": "string",
            "enum": ["qwen_record_accepted", "correction_needed", "uncertain"]
          },
          "basis": {"type": "string", "minLength": 1, "maxLength": 2400}
        }
      }
    },
    "final_qwen_reviewer_quality_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "overall_assessment": {
      "type": "string",
      "enum": ["pass", "warn", "fail"]
    },
    "boundary_limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 1600}
    },
    "release_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_results_changed",
        "training_authorized",
        "publication_authorized",
        "email_authorized"
      ],
      "properties": {
        "primary_results_changed": {"type": "boolean", "enum": [false]},
        "training_authorized": {"type": "boolean", "enum": [false]},
        "publication_authorized": {"type": "boolean", "enum": [false]},
        "email_authorized": {"type": "boolean", "enum": [false]}
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 3200}
  }
}
